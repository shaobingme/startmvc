# ===========================================
# StartMVC 环境配置文件
# ===========================================
# 使用方法：复制此文件为 .env 并修改配置
#   cp .env.example .env
#
# 配置优先级：.env 环境变量 > config/database.php 默认值
# 如果不创建 .env 文件，框架将使用 config/database.php 中的默认配置
# 注意：.env 文件包含敏感信息，不应提交到版本控制系统
# ===========================================

# 应用环境（production / development）
APP_ENV=production
APP_DEBUG=false

# ===========================================
# 数据库配置（支持 mysql / sqlite / pgsql / oracle）
# 需要开启 pdo、pdo_mysql 扩展
# ===========================================

# 数据库类型：mysql / sqlite / pgsql / oracle
DB_DRIVER=mysql

# 数据库服务器地址
DB_HOST=localhost

# 数据库端口（mysql默认3306，pgsql默认5432）
DB_PORT=3306

# 数据库名称
DB_DATABASE=startmvc

# 数据库用户名
DB_USERNAME=root

# 数据库密码
DB_PASSWORD=

# 数据库字符集
DB_CHARSET=utf8

# 数据表编码
DB_COLLATION=utf8_general_ci

# 数据表前缀
DB_PREFIX=sm_